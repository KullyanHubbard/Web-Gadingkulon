# =========================================================================
# NIA Web — Frontend environment variables
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# Semua variabel yang diakses di client WAJIB berprefix VITE_.
# =========================================================================

# Base URL API backend (FastAPI). Saat dev bisa lewat proxy Vite ("/api").
VITE_API_BASE_URL=/api

# Sumber data: "mock" (tanpa backend) atau "http" (panggil FastAPI beneran).
# Selama backend belum dibuat, biarkan "mock".
VITE_API_MODE=mock

# Nama aplikasi (dipakai di title & header).
VITE_APP_NAME=SIDUK
