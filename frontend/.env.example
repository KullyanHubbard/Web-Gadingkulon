# =========================================================================
# NIA Web — Frontend environment variables
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# Semua variabel yang diakses di client WAJIB berprefix VITE_.
# =========================================================================

# Base URL API backend (FastAPI). Jalankan backend dulu (lihat backend/README.md).
VITE_API_BASE_URL=http://localhost:8000

# Nama aplikasi (dipakai di title & header).
VITE_APP_NAME=SIDUK
