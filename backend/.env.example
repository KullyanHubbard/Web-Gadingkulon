# =========================================================================
# SIDUK Backend — environment variables
# Salin file ini menjadi `.env` lalu sesuaikan nilainya. `.env` di-gitignore.
# Semua nilai di bawah adalah DEFAULT yang sudah dipakai kalau `.env` tidak ada,
# jadi backend tetap jalan tanpa file ini. Lihat app/core/config.py.
# =========================================================================

# --- Runtime -------------------------------------------------------------
# Path file SQLite (bukan URL). Relatif = dihitung dari folder `backend/`.
# File & foldernya dibuat otomatis saat backend pertama kali jalan, tapi ISINYA
# tidak diisi sendiri: data penduduk masuk lewat
#   .venv/bin/python -m app.data.impor_excel ../docs/data-penduduk.xlsx
# Jangan pernah di-commit — begitu isinya data warga sungguhan, satu commit
# menaruh data kependudukan sedesa di riwayat git secara permanen.
DATABASE_PATH=./data/siduk.db

# WAJIB diisi. Backend MENOLAK JALAN kalau nilainya masih bawaan — kunci contoh
# itu tertulis di kode publik, jadi siapa pun bisa membuat token masuk palsu.
# Bangkitkan sekali:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-nilai-acak-panjang

# Umur token sesi, dalam jam.
JWT_TTL_JAM=12

# Asal yang boleh memanggil API, dipisah koma (bukan JSON).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Akun ADMIN pertama --------------------------------------------------
# WAJIB diisi saat pertama kali menjalankan backend dengan database kosong:
# tanpa ini tidak ada satu pun akun yang bisa masuk, dan backend menolak jalan.
# Setelah akun ADMIN pertama terbentuk, dua nilai ini tidak dipakai lagi.
ADMIN_USERNAME=dukuh
ADMIN_PASSWORD=ganti-password-ini
