# =========================================================================
# SIDUK Backend — environment variables
# Salin file ini menjadi `.env` lalu sesuaikan nilainya. `.env` di-gitignore.
# Semua nilai di bawah adalah DEFAULT yang sudah dipakai kalau `.env` tidak ada,
# jadi backend tetap jalan tanpa file ini. Lihat app/core/config.py.
# =========================================================================

# --- Runtime -------------------------------------------------------------
# Path file SQLite (bukan URL). Relatif = dihitung dari folder `backend/`.
# File & foldernya dibuat otomatis saat backend pertama kali jalan, lalu diisi
# dari generator dummy. Mau dataset baru? Hapus filenya, jalankan ulang.
# Jangan pernah di-commit — sudah di-gitignore.
DATABASE_PATH=./data/siduk.db

# WAJIB diganti di produksi. Default di kode sengaja bertuliskan "dev-only".
JWT_SECRET=dev-only-ganti-di-produksi

# Umur token sesi, dalam jam.
JWT_TTL_JAM=12

# Asal yang boleh memanggil API, dipisah koma (bukan JSON).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seed / generator data dummy -----------------------------------------
# Dipakai sekali saat data dibangkitkan, bukan tiap request. Ubah nilainya =
# dataset berubah; SEED_RANDOM_SEED yang bikin hasilnya sama tiap restart.
SEED_JUMLAH_KELUARGA=200
SEED_RANDOM_SEED=20260814

# 6 digit, jadi prefiks NIK & no KK. Selain 6 digit ditolak saat startup.
SEED_KODE_WILAYAH=320412

# Daftar RW, dipisah koma.
SEED_RW_LIST=019,020,021

# Jumlah RT di tiap RW. Nomornya berurutan lintas RW: dengan daftar RW di atas
# dan nilai 2, RW 019 = RT 001-002, RW 020 = RT 003-004, RW 021 = RT 005-006.
SEED_RT_PER_RW=2

# Alamat wilayah yang ditempelkan ke setiap penduduk.
SEED_DESA=Sukamaju
SEED_KECAMATAN=Cibiru
SEED_KABUPATEN=Bandung
SEED_PROVINSI=Jawa Barat
SEED_KODE_POS=40615
